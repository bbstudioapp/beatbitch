{
  "displayLabel": "Primer hold profundo",
  "stepTexts": {
    "0": "Hoy te lo tragas entero.",
    "10": "Aguántala entera. Dos segundos.",
    "12": "Respira hondo.",
    "22": "Otra vez. Cuatro segundos.",
    "26": "Respira a fondo.",
    "38": "El último. Seis segundos, nariz contra mi vientre.",
    "44": "Muy bien. Descansa."
