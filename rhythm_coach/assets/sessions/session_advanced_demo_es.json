{
  "lang": "es",
  "id": "petite_salope_30_naturelle",
  "name": "Putita – 30 minutos",
  "description": "Sesión larga, intensa y natural",
  "duration_seconds": 1800,
  "mode": "rhythm",
  "intro": "De rodillas, putita. Treinta minutos solo para mí — más te vale estar bien colocada, boca lista, garganta abierta. Vamos a alternar ritmos, profundidades, pausas. No pienses, obedece. Si realmente no puedes más, el botón rojo activa tu castigo. Confirma cuando estés lista para pertenecerme.",
  "steps": [
    {"time": 0,   "text": "De rodillas, putita. Abre la boca.",
                  "from": "tip", "to": "head", "bpm": 50, "duration": 40},
    {"time": 35,  "text": "Lame suave alrededor del glande."},

    {"time": 70,  "text": "Métete más en la boca ahora.",
                  "from": "head", "to": "mid", "bpm": 65, "duration": 50},
    {"time": 110, "text": "Así, sigue así."},

    {"time": 150, "text": "Más al fondo, hasta el final de tu garganta.",
                  "from": "mid", "to": "throat", "bpm": 72, "duration": 60},
    {"time": 200, "text": "Tómalo todo, puta."},

    {"time": 230, "text": "Lámela bien, lengua fuera.",
                  "mode": "lick", "from": "tip", "to": "head", "bpm": 75, "duration": 45},
    {"time": 265, "text": "Escupe encima, déjala bien mojada."},

    {"time": 290, "text": "Vuelve al fondo, más rápido ahora.",
                  "mode": "rhythm", "from": "mid", "to": "throat", "bpm": 88, "duration": 70},
    {"time": 350, "text": "Oigo tu garganta, es perfecto."},

    {"time": 380, "text": "Quédate al fondo. No te muevas.",
                  "mode": "hold", "to": "throat", "duration": 18},
    {"time": 405, "text": "Respira por la nariz… y zambúllete otra vez."},

    {"time": 430, "text": "Baja ahora hasta los huevos.",
                  "mode": "rhythm", "from": "throat", "to": "full", "bpm": 78, "duration": 80},
    {"time": 500, "text": "Nariz contra los huevos como una buena puta."},

    {"time": 540, "text": "Más rápido, destrózate la garganta.",
                  "mode": "biffle", "bpm": 125, "duration": 55},
    {"time": 580, "text": "Babea por todas partes, déjalo todo correr."},

    {"time": 610, "text": "Quédate al fondo, mantenla bien.",
                  "mode": "hold", "to": "full", "duration": 22},
    {"time": 640, "text": "Toma aire… y seguimos."},

    {"time": 670, "text": "Alterna garganta y fondo, más rápido.",
                  "mode": "rhythm", "from": "throat", "to": "full", "bpm": 98, "duration": 100},
    {"time": 750, "text": "No eres más que un agujero para polla."},

    {"time": 790, "text": "Lame despacio, por todas partes.",
                  "mode": "lick", "from": "tip", "to": "head", "bpm": 65, "duration": 50},
    {"time": 830, "text": "Así, putita, sigue así."},

    {"time": 870, "text": "Ahora te lo tragas todo, sin parar.",
                  "mode": "rhythm", "from": "throat", "to": "full", "bpm": 115, "duration": 130},
    {"time": 970, "text": "¡Más fuerte, puta!"},
    {"time": 1010, "text": "Babea, llora, me da igual."},

    {"time": 1100, "text": "Quédate al fondo, tanto como puedas.",
                  "mode": "hold", "to": "full", "duration": 28},
    {"time": 1135, "text": "Respira… y zambúllete otra vez de inmediato."},

    {"time": 1170, "text": "Cadencia rápida, garganta profunda.",
                  "mode": "biffle", "bpm": 140, "duration": 70},
    {"time": 1230, "text": "Eres una guarra goteante de verdad."},

    {"time": 1280, "text": "Alterna rápido, del glande hasta el fondo.",
                  "mode": "rhythm", "from": "head", "to": "full", "bpm": 108, "duration": 160},
    {"time": 1400, "text": "Ni se te ocurra parar."},
    {"time": 1450, "text": "Dilo: soy tu agujero para leche."},

    {"time": 1530, "text": "Último hold, hasta el fondo.",
                  "mode": "hold", "to": "full", "duration": 35},
    {"time": 1570, "text": "Respira hondo…"},

    {"time": 1600, "text": "Último sprint, dalo todo.",
                  "mode": "rhythm", "from": "head", "to": "full", "bpm": 118, "duration": 170},
    {"time": 1720, "text": "¡Más rápido! ¡Más al fondo!"},
    {"time": 1770, "text": "Eres mía."},

    {"time": 1790, "text": "Quédate al fondo hasta el final.",
                  "mode": "hold", "to": "full", "duration": 10},
    {"time": 1800, "text": "Terminado. Has sido una putita muy obediente."}
  ]
}
